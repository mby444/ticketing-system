// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
  SUPPORT_AGENT
}

enum TicketStatus {
  Open
  In_Progress
  Resolved
  Closed
}

// Values are capitalised to match TicketStatus and to match the data that
// already exists, so introducing the enum required no data movement.
enum TicketPriority {
  Low
  Medium
  High
  Critical
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  role            Role     @default(CLIENT)
  password        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tickets         Ticket[] @relation("OwnedTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
  comments        TicketComment[]
  attachmentsUploaded TicketAttachment[] @relation("UploadedAttachments")
}

model Ticket {
  id          Int          @id @default(autoincrement())
  subject     String
  description String
  priority    TicketPriority
  status      TicketStatus @default(Open)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String
  user        User         @relation("OwnedTickets", fields: [userId], references: [id])
  assigneeId  String?
  assignedTo  User?        @relation("AssignedTickets", fields: [assigneeId], references: [id])
  attachments TicketAttachment[]
  comments    TicketComment[]
}

model TicketAttachment {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  url          String
  publicId     String
  resourceType String
  createdAt    DateTime @default(now())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Deliberately has NO onDelete: the uploader trace is audit data, so
  // deleting a user must be blocked (default NO ACTION) rather than silently
  // erasing files they uploaded onto somebody else's ticket. This matches
  // Ticket.userId. Deleting the ticket still cascades the attachment away.
  uploadedById String
  uploadedBy   User     @relation("UploadedAttachments", fields: [uploadedById], references: [id])

  @@index([ticketId])
}

model TicketComment {
  id        Int      @id @default(autoincrement())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}
