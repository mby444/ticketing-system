// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
  SUPPORT_AGENT
}

enum TicketStatus {
  Open
  In_Progress
  Resolved
  Closed
}

// Values are capitalised to match TicketStatus and to match the data that
// already exists, so introducing the enum required no data movement.
enum TicketPriority {
  Low
  Medium
  High
  Critical
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  role            Role     @default(CLIENT)
  password        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tickets         Ticket[] @relation("OwnedTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
  attachmentsUploaded TicketAttachment[] @relation("UploadedAttachments")
  // Both User -> TicketComment relations must be named now that there are two.
  comments        TicketComment[] @relation("CommentAuthor")
  deletedComments TicketComment[] @relation("CommentDeletedBy")
  commentAttachmentsUploaded CommentAttachment[] @relation("UploadedCommentAttachments")
  notifications Notification[]
}

enum NotificationType {
  TICKET_CREATED
  STATUS_UPDATED
  NEW_COMMENT
  TICKET_ASSIGNED
  TICKET_UNASSIGNED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  ticketId  Int
  ticket    Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  dedupeKey String

  @@unique([userId, type, ticketId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Ticket {
  id          Int          @id @default(autoincrement())
  subject     String
  description String
  priority    TicketPriority
  status      TicketStatus @default(Open)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String
  user        User         @relation("OwnedTickets", fields: [userId], references: [id])
  assigneeId  String?
  assignedTo  User?        @relation("AssignedTickets", fields: [assigneeId], references: [id])
  attachments TicketAttachment[]
  comments    TicketComment[]
  notifications Notification[]
}

model TicketAttachment {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  url          String
  publicId     String
  resourceType String
  createdAt    DateTime @default(now())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Deliberately has NO onDelete: the uploader trace is audit data, so
  // deleting a user must be blocked (default NO ACTION) rather than silently
  // erasing files they uploaded onto somebody else's ticket. This matches
  // Ticket.userId. Deleting the ticket still cascades the attachment away.
  uploadedById String
  uploadedBy   User     @relation("UploadedAttachments", fields: [uploadedById], references: [id])

  @@index([ticketId])
}

model TicketComment {
  id        Int      @id @default(autoincrement())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  // Soft delete. The row is kept so a two-way thread never shows a hole where
  // a support reply used to be; the body is never rendered once deletedAt is
  // set. deletedById is SetNull (not Cascade) so removing the moderator later
  // cannot erase the record of the removal.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("CommentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  // Files attached to this comment. A separate model from TicketAttachment on
  // purpose: the two have independent budgets (MAX_FILES per ticket,
  // MAX_COMMENT_FILES per comment) and independent delete paths, and a comment
  // can be soft-deleted while its ticket lives on.
  //
  // These rows are NOT deleted when the comment is soft-deleted — the thread is
  // frozen, not erased. They simply stop being rendered, which is why
  // deleteCommentAttachment refuses to touch them.
  attachments CommentAttachment[]

  @@index([ticketId, createdAt])
}

model CommentAttachment {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  url          String
  publicId     String
  resourceType String
  createdAt    DateTime @default(now())
  commentId    Int
  comment      TicketComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  // Deliberately has NO onDelete, for the same reason as
  // TicketAttachment.uploadedById: the uploader is audit data, so deleting a
  // user who uploaded a file must be blocked (RESTRICT) rather than silently
  // removing files from a thread they do not own.
  uploadedById String
  uploadedBy   User     @relation("UploadedCommentAttachments", fields: [uploadedById], references: [id])

  @@index([commentId])
}
